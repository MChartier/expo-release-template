{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/MChartier/expo-release-template/main/schemas/release.config.schema.json",
  "title": "ReleaseConfiguration",
  "description": "Declarative application boundary. The package validator additionally checks component references, supported ordering and version lane consistency.",
  "type": "object",
  "required": ["schemaVersion", "repository", "defaultBranch", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": { "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$" },
    "defaultBranch": { "type": "string", "minLength": 1, "pattern": "^[\\w./-]+$" },
    "defaultProfile": { "type": "string" },
    "packageDirectories": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "profiles": { "type": "object", "additionalProperties": { "type": "object", "properties": {"easProfile":{"type":"string"},"channel":{"type":"string"},"environment":{"type":"string"},"distribution":{"type":"string"},"submit":{"type":"boolean"},"execution":{"enum":["local","hosted"]},"environmentSource":{"enum":["declared","provider"]},"publicEnvironment":{"type":"object","additionalProperties":{"type":"string"}},"expo":{"type":"object","properties":{"serverUrl":{"type":"string"}}}} } },
    "components": { "type": "array", "minItems": 1, "description": "At most one server component is supported by the fixed deployment target; the runtime validator checks this constraint.", "items": { "$ref": "#/definitions/component" } },
    "expo": { "type": "object", "description": "Project/owner/server values may use inert JSON file/pointer mappings; no executable configuration is loaded by privileged jobs." },
    "hooks": {
      "type": "object", "additionalProperties": false,
      "properties": { "inspect": { "$ref": "#/definitions/hook" }, "prepare": { "$ref": "#/definitions/hook" }, "validate": { "$ref": "#/definitions/hook" }, "build": { "$ref": "#/definitions/hook" }, "verify": { "$ref": "#/definitions/hook" } }
    },
    "versionGroups": { "type": "array", "items": { "type": "object", "required": ["id", "targets"], "properties": {
      "id": { "type": "string" }, "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
      "version": { "$ref": "#/definitions/mapping" }, "codeAllocation": { "enum": ["global", "independent"] }, "bump": { "enum": ["patch", "requested"] }, "minimumCode": {"type":"integer","minimum":0}, "reusePrepared": {"type":"boolean"}, "lanes": {"type":"object","additionalProperties":{"type":"object","required":["modulus","residue"],"properties":{"modulus":{"type":"integer","minimum":1},"residue":{"type":"integer","minimum":0}},"additionalProperties":false}}, "minimumVersion": {"type":"string","pattern":"^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"}, "minimumCodes": {"type":"object","additionalProperties":{"type":"integer","minimum":0,"maximum":2100000000}}
    } } },
    "policy": { "type": "object" },
    "local": { "type": "object", "properties": {
      "settingsDirectory": { "type": "string" }, "settingsFile": { "type": "string" },

      "submissions": { "type": "object", "description": "Explicit local Android internal-track permission. Local evidence never becomes hosted provenance.",
        "additionalProperties": { "type": "object", "required": ["track"], "properties": {
          "track": { "type": "string", "pattern": "^(?:[a-z0-9._-]+:)?internal$" }
        } }
      }
    }, "additionalProperties": false },
    "promotions": { "type": "object", "additionalProperties": { "type": "object", "required": ["targets", "tracks", "approvalEnvironment", "credentials"], "properties": {
      "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
      "tracks": { "type": "object", "additionalProperties": { "type": "object", "required": ["source", "destination"], "properties": {
        "source": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,99}$" }, "destination": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,99}$" },
        "sourceMarkerPrefix": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,60}$" }
      } } },
      "approvalEnvironment": { "type": "string", "minLength": 1 },
      "credentials": { "type": "object", "minProperties": 1, "additionalProperties": false, "properties": {
        "accessToken": { "type": "string", "pattern": "^GOOGLE_PLAY_[A-Z0-9_]{1,70}$" }, "serviceAccountBase64": { "type": "string", "pattern": "^GOOGLE_PLAY_[A-Z0-9_]{1,70}$" }
      }, "title": "PromotionCredentials" }
    }, "title": "PromotionConfiguration" } },
    "github": { "type": "object", "properties": { "requestWorkflow": { "type": "string" }, "handlerWorkflow": { "type": "string" }, "recoveryWorkflow": { "type": "string" } } },
    "deployment": { "type": "object", "required": ["type"], "properties": { "type": { "const": "wireguard-webhook" } } }, "nativeGroups": {"type":"array","items":{"type":"array","uniqueItems":true,"items":{"type":"string"},"minItems":2}}, "dependencies": {"type":"array","items":{"type":"object","required":["component","requires"],"properties":{"component":{"type":"string"},"requires":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"when":{"enum":["version-reservation"]}}}}, "inspection": {"type":"object","properties":{"environment":{"type":"object","additionalProperties":{"type":"string"}}}}, "validation": {"type":"object","properties":{"environment":{"type":"object","additionalProperties":{"type":"string"}}}}, "attestations": {"type":"object"}, "metadataFiles": {"type":"array","items":{"type":"string"},"uniqueItems":true}, "trust": {"type":"object"}
  },
  "definitions": {
    "mapping": { "type": "object", "required": ["file", "pointer"], "properties": { "file": { "type": "string", "minLength": 1 }, "pointer": { "type": "string", "pattern": "^/" }, "optional": { "type": "boolean" }, "codePointer": { "type": "string", "pattern": "^/" }, "codeType": { "const": "string" }, "mirrors": { "type": "array", "items": { "$ref": "#/definitions/mapping" } } }, "title": "JsonMapping" },
    "hook": { "type": "object", "required": ["command"], "properties": { "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "timeoutMs": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
    "component": {
      "type": "object", "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "maxLength": 80, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$" }, "kind": { "enum": ["server", "native", "ota"] },
        "platform": { "enum": ["android", "ios"] }, "builder": { "enum": ["command", "eas"] }, "localBuilder": { "enum": ["command", "eas"], "description": "Explicit local-only override. EAS local builds support iOS on macOS; hosted builder policy is unchanged." },
        "appDirectory": { "type": "string", "minLength": 1 }, "applicationId": { "type": "string", "minLength": 1 }, "nativeTarget": { "type": "string" },
        "version": { "$ref": "#/definitions/mapping" }, "runtimePolicy": { "enum": ["appVersion", "fingerprint"] },
        "publication": { "type": "object", "required": ["movingTag"], "properties": { "gitTagPrefix": { "type": "string" }, "movingTag": { "type": "string" } }, "additionalProperties": false },
        "smoke": { "type": "object", "required": ["port", "healthPath"], "properties": {
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 }, "healthPath": { "type": "string", "pattern": "^/[A-Za-z0-9/_.-]*$" }, "timeoutSeconds": { "type": "integer", "minimum": 1 },
          "environment": { "type": "object", "additionalProperties": { "type": "string" } },
          "services": { "type": "object", "additionalProperties": { "type": "object", "required": ["image"], "properties": { "image": { "type": "string", "minLength": 1 }, "environment": { "type": "object", "additionalProperties": { "type": "string" } } } } }
        }, "additionalProperties": false, "title": "ServerSmokeConfiguration" },
        "environmentSource": { "enum": ["declared", "provider"] },
        "runtimeCompatibility": { "enum": ["exact", "fingerprint"], "description": "Fingerprint compatibility requires a fingerprint native runtime whose exact full hash equals the OTA runtime." },
        "runtimeBinding": { "enum": ["native", "source"], "description": "Source binding explicitly records source validation without asserting an installed native runtime match." },
        "approvalEnvironment": { "oneOf": [{ "type": "string" }, { "type": "object", "additionalProperties": { "type": "string" } }], "description": "A fixed protected environment or a profile-to-environment map; an empty value uses the unapproved boundary." }, "signingEnvironment": { "type": "string" },
        "after": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "profiles": { "type": "array", "items": { "type": "string" } }, "profile": {"type":"string"}, "channel": {"type":"string"}, "environment": {"type":"string"}, "buildGroup": {"type":"string"}, "image": {"type":"string"}, "dockerfile": {"type":"string"}, "easProfile": {"type":"string"}, "submit": {"type":"boolean"}, "compareEnvironment": {"type":"boolean"}, "platforms": {"type":"array","uniqueItems":true,"items":{"type":"string"}}, "submission": {"type":"object"}
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "native" } } }, "then": { "required": ["platform", "builder"] } },
        { "if": { "properties": { "kind": { "const": "ota" } } }, "then": { "required": ["platform", "nativeTarget"], "properties": {"nativeTarget":{"type":"string","minLength":1}} } }
      ], "title": "TargetConfiguration"
    }
  }, "additionalProperties": false
}
